@startuml
title DataMorph File Converter - UML Class Diagram (PTE MIK Prog 2)

skinparam classAttributeIconSize false
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 8

package "hu.mik.prog2.converter.model" {
    enum FormatType {
        CSV
        JSON
        XML
        - extension: String
        - mimeType: String
        + getExtension(): String
        + getMimeType(): String
        + {static} fromFileNameOrExtension(name: String): FormatType
    }

    class DocumentHeader {
        - columns: List<String>
        + DocumentHeader(columns: List<String>)
        + getColumns(): List<String>
        + size(): int
        + getColumn(index: int): String
        + contains(name: String): boolean
    }

    class DocumentRecord {
        - data: Map<String, String>
        + DocumentRecord(data: Map<String, String>)
        + getValue(column: String): String
        + getValueOrDefault(column: String, defaultVal: String): String
        + getData(): Map<String, String>
        + size(): int
    }

    class Document {
        - header: DocumentHeader
        - records: List<DocumentRecord>
        + Document(header: DocumentHeader, records: List<DocumentRecord>)
        + getHeader(): DocumentHeader
        + getRecords(): List<DocumentRecord>
        + getRecordCount(): int
        + getColumnCount(): int
        + isEmpty(): boolean
    }

    class ConversionJob {
        - sourcePath: Path
        - targetPath: Path
        - sourceFormat: FormatType
        - targetFormat: FormatType
        - requestedAt: LocalDateTime
        + ConversionJob(src: Path, tgt: Path, srcFmt: FormatType, tgtFmt: FormatType)
        + getSourcePath(): Path
        + getTargetPath(): Path
        + getSourceFormat(): FormatType
        + getTargetFormat(): FormatType
        + getRequestedAt(): LocalDateTime
    }

    class ConversionHistoryItem {
        - id: String
        - timestamp: LocalDateTime
        - sourcePath: String
        - targetPath: String
        - sourceFormat: FormatType
        - targetFormat: FormatType
        - fileSizeBytes: long
        - recordCount: int
        - durationMillis: long
        - success: boolean
        - errorMessage: String
        + {static} BY_DURATION: Comparator<ConversionHistoryItem>
        + {static} BY_FILE_SIZE: Comparator<ConversionHistoryItem>
        + {static} BY_SOURCE_NAME: Comparator<ConversionHistoryItem>
        + {static} BY_STATUS: Comparator<ConversionHistoryItem>
        + compareTo(other: ConversionHistoryItem): int
        + getId(): String
        + getTimestamp(): LocalDateTime
        + isSuccess(): boolean
    }

    class "BatchResult<T>" as BatchResult {
        - successfulItems: List<T>
        - failedItems: List<T>
        - failureMessages: List<String>
        + addSuccess(item: T): void
        + addFailure(item: T, msg: String): void
        + getSuccessfulItems(): List<T>
        + getFailedItems(): List<T>
        + getTotalCount(): int
        + isAllSuccessful(): boolean
    }
}

package "hu.mik.prog2.converter.strategy" {
    interface FormatStrategy {
        + parse(in: InputStream): Document
        + write(doc: Document, out: OutputStream): void
        + getFormatType(): FormatType
    }

    abstract class AbstractFormatStrategy {
        # DEFAULT_CHARSET: Charset
        - formatType: FormatType
        # AbstractFormatStrategy(formatType: FormatType)
        + getFormatType(): FormatType
        # createReader(in: InputStream): BufferedReader
        # createWriter(out: OutputStream): BufferedWriter
        # validateDocumentForWriting(doc: Document): void
    }

    class CsvFormatStrategy {
        - delimiter: char
        + CsvFormatStrategy()
        + CsvFormatStrategy(delimiter: char)
        + parse(in: InputStream): Document
        + write(doc: Document, out: OutputStream): void
    }

    class JsonFormatStrategy {
        + JsonFormatStrategy()
        + parse(in: InputStream): Document
        + write(doc: Document, out: OutputStream): void
    }

    class XmlFormatStrategy {
        + XmlFormatStrategy()
        + parse(in: InputStream): Document
        + write(doc: Document, out: OutputStream): void
    }

    class FormatStrategyFactory {
        - strategyRegistry: Map<FormatType, FormatStrategy>
        + FormatStrategyFactory()
        + registerStrategy(strategy: FormatStrategy): void
        + getStrategy(formatType: FormatType): FormatStrategy
        + getStrategyForPath(path: Path): FormatStrategy
    }
}

package "hu.mik.prog2.converter.persistence" {
    interface HistoryRepository {
        + loadAll(): List<ConversionHistoryItem>
        + saveAll(items: List<ConversionHistoryItem>): void
        + append(item: ConversionHistoryItem): void
        + clear(): void
    }

    class JsonHistoryRepository {
        - storagePath: Path
        + JsonHistoryRepository(storagePath: Path)
        + loadAll(): List<ConversionHistoryItem>
        + saveAll(items: List<ConversionHistoryItem>): void
        + append(item: ConversionHistoryItem): void
        + clear(): void
    }
}

package "hu.mik.prog2.converter.service" {
    class HistoryService {
        - repository: HistoryRepository
        - historyList: List<ConversionHistoryItem>
        + HistoryService(repository: HistoryRepository)
        + record(item: ConversionHistoryItem): void
        + getHistorySortedNatural(): List<ConversionHistoryItem>
        + getHistorySorted(cmp: Comparator<ConversionHistoryItem>): List<ConversionHistoryItem>
        + clearHistory(): void
        + getCount(): int
        + getSuccessfulCount(): long
    }

    class ConverterService {
        - strategyFactory: FormatStrategyFactory
        - historyService: HistoryService
        + ConverterService(factory: FormatStrategyFactory, history: HistoryService)
        + convert(job: ConversionJob): ConversionHistoryItem
        + convert(src: Path, tgt: Path): ConversionHistoryItem
        + convertBatch(jobs: List<ConversionJob>): BatchResult<ConversionHistoryItem>
        + convertDirectory(srcDir: Path, tgtDir: Path, fmt: FormatType): BatchResult<ConversionHistoryItem>
    }
}

package "hu.mik.prog2.converter.ui" {
    class ConsoleMenu {
        - converterService: ConverterService
        - historyService: HistoryService
        - scanner: Scanner
        + ConsoleMenu(converterService: ConverterService)
        + run(): void
    }
}

class Main {
    + {static} main(args: String[]): void
}

' Realization & Inheritance
AbstractFormatStrategy ..|> FormatStrategy
CsvFormatStrategy --|> AbstractFormatStrategy
JsonFormatStrategy --|> AbstractFormatStrategy
XmlFormatStrategy --|> AbstractFormatStrategy
JsonHistoryRepository ..|> HistoryRepository
ConversionHistoryItem ..|> java.lang.Comparable

' Composition & Aggregation
Document "1" *-- "1" DocumentHeader : contains
Document "1" *-- "0..*" DocumentRecord : rows
HistoryService "1" o-- "0..*" ConversionHistoryItem : manages

' Associations
ConversionJob --> FormatType : uses
ConversionHistoryItem --> FormatType : records
ConverterService --> FormatStrategyFactory : uses
ConverterService --> HistoryService : records to
HistoryService --> HistoryRepository : delegates persistence
FormatStrategyFactory ..> FormatStrategy : creates
ConsoleMenu --> ConverterService : interacts
Main ..> ConsoleMenu : starts

@enduml
